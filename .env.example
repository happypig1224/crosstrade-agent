# -----------------------------------------------------------------------------
# CrossTrade Agent - 环境配置字典模版
# 复制本文件为 .env 或设置对应的系统环境变量
# -----------------------------------------------------------------------------

# 通义千问 / DashScope API 配置 (必填)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# 服务端口
SERVER_PORT=8088

# MySQL 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=crosstrade_agent
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# Redis 缓存与 Redisson 分布式锁配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456

# Apache RocketMQ 消息队列配置
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=crosstrade-agent-producer
ROCKETMQ_CONSUMER_GROUP=crosstrade-agent-consumer

# Milvus 向量数据库配置
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_TOKEN=

# 定时任务开关 (true/false)
SCHEDULE_PORTRAIT_UPDATE_ENABLED=true
SCHEDULE_ARCHIVE_ENABLED=true
